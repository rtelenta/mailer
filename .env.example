# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Base URL of the SSO service this app authenticates against (no trailing slash)
SSO_BASE_URL=http://sso.localhost:3005

# OAuth client ID registered in the SSO service
SSO_CLIENT_ID=your-client-id

# OAuth client secret registered in the SSO service
SSO_CLIENT_SECRET=your-client-secret

# Secret used by better-auth to sign sessions (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret

# Public base URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://mailer.localhost:3006

# API key for Resend email delivery service (get one at resend.com/api-keys)
RESEND_API_KEY=

# Verified sender address (e.g. onboarding@resend.dev for Resend sandbox, or noreply@yourdomain.com)
FROM_ADDRESS=
meta {
  name: Send Email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/send
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{apiToken}}
  Content-Type: application/json
}

body:json {
  {
    "templateName": "Welcome Email",
    "to": "recipient@example.com",
    "content": {
      "firstName": "Alice",
      "productName": "Mailer"
    }
  }
}
